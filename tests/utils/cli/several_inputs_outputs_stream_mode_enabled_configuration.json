{
  "verbose": true,
  "stream": true,
  "input": {
      "puller2": {
          "model": "HWPCReport",
          "type": "csv",
          "files": ["/tmp/rapl.csv", "/tmp/msr.csv"]
      },
      "puller3": {
          "model": "HWPCReport",
          "type": "socket",
          "host": "localhost",
          "port": 1111
      },
      "puller4": {
          "model": "HWPCReport",
          "type": "json",
          "filepath": "/tmp/pytest-powerapi.jsonl",
          "compression": "none"
      }
  },
  "output": {
      "fourth_pusher": {
          "type": "csv",
          "model": "PowerReport",
          "directory": "my_dir"
      },
      "seventh_pusher": {
          "type": "json",
          "model": "FormulaReport",
          "filepath": "my_output_filepath",
          "compression": "none"
      }
  }
}
